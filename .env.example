# Required in production (Railway Postgres or Neon)
DATABASE_URL=postgresql://user:password@host:5432/edge_weekly

# Public site URL used in RSS, sitemap, and private preview links
SITE_URL=https://your-app.up.railway.app

# Admin / trigger routes fail closed if this is missing
# Used to approve or reject an edition: POST /api/admin/editions
ADMIN_API_KEY=

# Optional extra secret for cron callers (ingest / compile only)
CRON_SECRET=

# Models (defaults are already set in config/models.ts)
MODEL_WRITING=claude-sonnet-5-5
MODEL_RANKING=claude-sonnet-5-5
MODEL_CHECKS=claude-haiku-4-5
ANTHROPIC_API_KEY=

# Publish gate: manual (default) or auto
PUBLISH_MODE=manual
# When auto is on, this forces human review instead of auto-publish
PUBLISH_KILL_SWITCH=false

# X ingest is off unless you turn this on (it costs per read)
FEATURE_X_SOURCES=false

# Local demo only. Never set this on Railway unless you intend to use a file database.
# ALLOW_PGLITE=true
# PGLITE_PATH=.data/edge-weekly

# Railway process role: web (default) or pipeline
PROCESS_ROLE=web
PIPELINE_JOB=compile
